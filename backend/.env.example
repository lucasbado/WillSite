# Desenvolvimento: copie para backend/.env.local. O backend não lê o .env de produção neste modo.
LOCAL_DATABASE_URL=sqlite:///willsite-local.db
LOCAL_JWT_SECRET_KEY=troque-por-um-segredo-local-aleatorio-com-32-ou-mais-caracteres
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Produção: APP_ENV=production (automático no Render), DATABASE_URL e JWT_SECRET_KEY obrigatórios.
# Configure também FRONTEND_URL e CORS_ORIGINS com o domínio real do frontend.
# Credenciais de e-mail só são usadas em produção.

# Assistente Groq opcional. Desativado por padrão, modo guiado funciona sem chave.
# Use uma conta Free sem faturamento para manter custo zero; o site não consegue conferir seu plano.
CHAT_AI_ENABLED=false
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b
# Limites locais globais, incluindo cada tentativa da cascata (não substituem as cotas do Groq).
CHAT_AI_DAILY_LIMIT=100
CHAT_AI_MINUTE_LIMIT=12
